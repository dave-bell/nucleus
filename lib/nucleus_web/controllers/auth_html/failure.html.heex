<.auth_card id="sign-in-failure" title="Sign-in didn't complete">
  <p class="text-base-content/70">
    We couldn't sign you in. Please try again, and contact your administrator if it keeps happening.
  </p>
  <.link id="sign-in-retry" href={~p"/sign-in"} class="btn btn-primary w-full">
    Try again
  </.link>
</.auth_card>
